/* =========================================
   MODO CLARO (Por defecto)
   ========================================= */
:root {
  --brand-primary: #6366F1;
  --brand-hover: #4F46E5;
  --brand-accent: #1E2542;

  --bg-canvas: #F8FAFC;
  --bg-card: #FFFFFF;
  --bg-elevated: #F1F5F9;
  --border-color: #E2E8F0;

  --text-primary: #0F172A;
  --text-secondary: #64748B;

  --status-success-text: #10B981;
  --status-success-bg: #ECFDF5;
  --status-warning-text: #F59E0B;
  --status-warning-bg: #FFFBEB;
  --status-danger-text: #EF4444;
  --status-danger-bg: #FEF2F2;
}

/* =========================================
   MODO OSCURO (Dark Mode)
   ========================================= */
[data-theme="dark"] {
  --brand-primary: #818CF8;
  --brand-hover: #6366F1;
  --brand-accent: #C7D2FE;

  --bg-canvas: #0B0F19;
  --bg-card: #131A2B;
  --bg-elevated: #1E293B;
  --border-color: #293548;

  --text-primary: #F8FAFC;
  --text-secondary: #94A3B8;

  --status-success-text: #34D399;
  --status-success-bg: rgba(6, 78, 59, 0.4);
  --status-warning-text: #FBBF24;
  --status-warning-bg: rgba(120, 53, 15, 0.4);
  --status-danger-text: #F87171;
  --status-danger-bg: rgba(127, 29, 29, 0.4);
}
